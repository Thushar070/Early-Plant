# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv-plantgpu
/.pip-cache
/.pip-tmp
/.venv/
/.venv-*/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep examples safe to commit)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local datasets and source recordings. Keep dataset documentation,
# metadata, and manifests visible to Git for reproducibility.
/datasets/plant_sounds/
/datasets/public_plantsounds/raw/
/datasets/public_plantsounds/PlantSounds.zip
/datasets/plant_stress_sound_dataset.csv
/train.csv
/val.csv
/test.csv

# Generated ML features, training histories, and checkpoints. Experiment
# reports/configs remain trackable unless they contain model binaries.
/ml/outputs/
/ml/models/**/*.joblib
/ml/models/**/*.pt
/ml/models/**/*.pth
/ml/models/**/*.ckpt
/ml/models/**/*.safetensors
/ml/experiments/**/selected_model.joblib
